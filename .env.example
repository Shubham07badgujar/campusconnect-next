# ==========================================================
# CampusConnect (Next.js) — Environment Configuration
# Copy to .env.local and fill in real values. Never commit .env.local.
# ==========================================================

# ---- Server ----
# PORT is set by the host (Render) automatically; locally defaults to 3000.
# PORT=3000

# Firebase Admin SDK — choose ONE:
# 1) Cloud (recommended): base64 of the service-account JSON
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# 2) Raw one-line JSON
# FIREBASE_SERVICE_ACCOUNT_JSON=
# 3) Local file at repo root (default: service-account-key.json)
FIREBASE_ADMIN_SDK_KEY=./service-account-key.json

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Gmail (credential + OTP emails; use an App Password)
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# REQUIRED: pepper for hashed password-reset OTPs
PASSWORD_RESET_OTP_SECRET=change-me-to-a-long-random-string

# Attendance
ATTENDANCE_DISTANCE_ENFORCEMENT=false

# Exam reminder announcements (optional)
ENABLE_EXAM_REMINDER_NOTIFICATIONS=false
# EXAM_REMINDER_INTERVAL_MS=21600000

# Gemini (optional AI-assisted OCR structuring)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_EXAM_MODEL=gemini-1.5-flash

# WebAuthn: extra allowed origins beyond the request origin (comma-separated).
# Normally NOT needed — the app is same-origin. Useful behind unusual proxies.
# WEBAUTHN_EXTRA_ORIGINS=

# ---- Logging & error monitoring ----
# Logs are structured JSON on stdout, which the host captures. Nothing here is
# required; the defaults are right for both local work and production.
#
# LOG_LEVEL: debug | info | warn | error   (default: info in production, debug locally)
# LOG_LEVEL=info
# LOG_FORMAT: json | pretty                (default: json in production, pretty locally)
# LOG_FORMAT=json

# Optional. An HTTPS endpoint that receives a JSON alert when a server-side
# error is reported. A Slack / Discord / Google Chat incoming webhook works as
# is — they all render the `text` field. Alerts are redacted, deduplicated per
# fault and capped at 10 per 5 minutes, so a retry storm cannot flood it.
# ERROR_ALERT_WEBHOOK_URL=

# On an uncaught exception the process reports and then exits so the host can
# restart it clean. Set to false to keep it running instead.
# ERROR_EXIT_ON_UNCAUGHT=true

# ---- Client (public by design — baked into the JS bundle) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
